# ═══════════════════════════════════════════════════════════════
# AEGIS — Backend Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/_/settings/api
# Project Settings → API Keys → a SECRET key (sb_secret_…), server-side only.
# The publishable key will not work: seed.sql grants the SQL function to
# service_role only, so the public key can never call it directly.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_...

# Management API key — used by `make db-reset` / `make restart` to reset & reseed the DB
# Get from: https://supabase.com/dashboard/account/tokens  →  Generate new token
SUPABASE_MANAGEMENT_KEY=sbp_...

# ── LLM API Keys ─────────────────────────────────────────────
# Required: GROQ (classification, simple-intent lane, Prompt Guard) and
# OPENAI (SQL + fallback lane). Optional: GOOGLE (complex-intent lane; falls
# over to OpenAI when missing or throttled) and ANTHROPIC.

# Google Gemini — complex-intent lane
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# OpenAI — GPT-4.1 for SQL, gpt-4.1-mini as the cross-provider fallback
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic Claude (alternative "smart" model)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Groq — gpt-oss models + Llama Prompt Guard 2 (injection screening)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ── Model Routing ────────────────────────────────────────────
# FAST_MODEL = used for intent classification (cheap/fast — gpt-oss-20b via Groq)
# SMART_MODEL = used for SQL generation & reasoning (accurate)
FAST_MODEL=openai/gpt-oss-20b
SMART_MODEL=gpt-4.1

# ── Redis (Semantic Cache) ───────────────────────────────────
# Default works with docker compose (starts Redis automatically)
# Or use a hosted Redis: https://upstash.com (free tier available)
# If Redis requires a password: redis://:YOUR_PASSWORD@localhost:6379
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── A2A (Agent2Agent protocol) ────────────────────────────────
# Public base URL advertised in /.well-known/agent-card.json
PUBLIC_API_URL=http://localhost:8000
# When set, approving or denying a proposed action over A2A requires
# `Authorization: Bearer <token>`. Leave empty for the open public demo,
# where anyone holding a task id can decide, same as the web UI.
A2A_APPROVER_TOKEN=

# ── LangSmith (Observability) ─────────────────────────────────
# Enables full trace visualization in LangSmith for every agent run
# Get your API key from: https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=aegis

# ── Debug ────────────────────────────────────────────────────
DEBUG=false

# ── Public-demo spend protection (optional; defaults shown) ──
# Per-visitor sliding window on POST /api/chat, plus a hard daily ceiling.
RATE_LIMIT_PER_CLIENT=8
RATE_LIMIT_WINDOW_SECONDS=600
DAILY_TICKET_CAP=300
MAX_MESSAGE_CHARS=1000
